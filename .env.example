# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Сетевой сервер (FastAPI / aiohttp)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Публичный URL для Telegram Mini App (HTTPS обязателен: https://your-domain.com или https://...ngrok-free.app)
WEBAPP_URL=https://localhost:8000

# Интервал проверки URL в секундах (по ТЗ: 300 секунд = 5 минут)
CHECK_INTERVAL_SECONDS=300

# Лимиты по ТЗ
MAX_URLS_PER_USER=5
MAX_HISTORY_PER_URL=20
CONSECUTIVE_FAILS_THRESHOLD=2

# Хранилище
DB_PATH=uptime_monitor.db
